#!/usr/bin/env php
<?php

define('LARAVEL_START', microtime(true));

$GLOBALS['_composer_bin_dir'] = __DIR__ . '/vendor/bin';
$GLOBALS['_composer_autoload_path'] = __DIR__ . '/vendor/autoload.php';

require __DIR__ . '/vendor/autoload.php';

// Handle `php artisan serve` directly in package to serve the documentation website
$args = $_SERVER['argv'] ?? [];
$command = $args[1] ?? '';

if ($command === 'serve' || $command === 'core:docs') {
    $port = 8000;
    $host = '127.0.0.1';

    foreach ($args as $arg) {
        if (str_starts_with($arg, '--port=')) {
            $port = (int) substr($arg, 7);
        } elseif (str_starts_with($arg, '--host=')) {
            $host = substr($arg, 7);
        }
    }

    $docsPath = realpath(__DIR__ . '/docs');
    $routerScript = $docsPath . DIRECTORY_SEPARATOR . 'server.php';
    $url = "http://{$host}:{$port}";

    // Check if port is already occupied on Windows and free it
    if (PHP_OS_FAMILY === 'Windows') {
        $checkCmd = "powershell -NoProfile -Command \"Get-NetTCPConnection -LocalPort {$port} -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess -First 1\"";
        $pid = trim((string) shell_exec($checkCmd));
        if ($pid && is_numeric($pid)) {
            echo "  \033[33;1m ⚠️ Port {$port} is in use by PID {$pid}. Reclaiming port...\033[0m\n";
            shell_exec("taskkill /F /PID {$pid} 2>&1");
            usleep(500000);
        }
    }

    echo "\n";
    echo "  \033[33;1m 📚 My Laravel Core Documentation Server \033[0m\n";
    echo "  \033[32;1m   INFO \033[0m Server running on [{$url}].\n\n";
    echo "  Press Ctrl+C to stop the server\n\n";

    // Auto open browser on Windows
    if (PHP_OS_FAMILY === 'Windows') {
        pclose(popen("start {$url}", "r"));
    }

    passthru("php -S {$host}:{$port} -t \"{$docsPath}\" \"{$routerScript}\"");
    exit(0);
}

// For all other commands, forward to Testbench
return include __DIR__ . '/vendor/orchestra/testbench-core/testbench';
