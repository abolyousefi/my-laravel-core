{
    "name": "my-laravel/core",
    "description": "An enterprise-grade Laravel core infrastructure package featuring rich RTL Blade UI components, Artisan code generators, Jalali dates, payment & SMS managers, dynamic filters, and utilities.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "My Laravel Team",
            "email": "core@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/view": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "MyLaravelCore\\": "src/"
        },
        "files": [
            "src/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "MyLaravelCore\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MyLaravelCore\\Providers\\CoreServiceProvider"
            ],
            "aliases": {
                "Core": "MyLaravelCore\\Facades\\Core"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
